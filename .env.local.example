# Copy this file to .env.local and fill in your PostgreSQL credentials.

# --- Opsi 1: PostgreSQL lokal (dipakai saat development) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=your-postgres-user
DB_PASSWORD=
DB_NAME=crud_produk
DB_SSL=false

# --- Opsi 2: database hosted, mis. Aiven (dipakai saat deploy) ---
# Kalau DATABASE_URL diisi, seluruh nilai DB_* di atas diabaikan.
# DATABASE_URL=postgresql://avnadmin:PASSWORD@host:port/defaultdb?sslmode=require

# Base64 dari CA certificate milik service (download ca.pem dari halaman
# Overview service di Aiven, lalu jalankan: base64 -i ca.pem | tr -d '\n').
# Kalau diisi, koneksi diverifikasi penuh terhadap CA tersebut.
# DB_CA_CERT=
